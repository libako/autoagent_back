{
  "Kernel": {
    "TimeoutSeconds": 30,
    "Provider": "openai",
    "MaxCacheSize": 50,
    "CacheTtlMinutes": 60
  },
  "Providers": {
    "OpenAI": {
      "Model": "gpt-4o",
      "ApiKey": "env:OPENAI_API_KEY"
    },
    "AzureOpenAI": {
      "Endpoint": "https://cog-tkt-chatgpt-dev-openai-003.openai.azure.com/",
      "Deployment": "gpt-4o",
      "ApiKey": "env:AZURE_OPENAI_API_KEY"
    },
    "Anthropic": {
      "Endpoint": "https://api.anthropic.com",
      "Model": "claude-3-5-sonnet-latest",
      "ApiKey": "env:ANTHROPIC_API_KEY"
    }
  },
  "Planner": {
    "Temperature": 0.0,
    "TopP": 0.1,
    "MaxTokens": 2000,
    "MaxSteps": 6,
    "StepLimit": 8,
    "MinIterationMs": 0
  },
  "Timeouts": {
    "MCPToolSeconds": 30,
    "SKToolSeconds": 30,
    "PlannerSeconds": 60,
    "SummarySeconds": 45
  },
  "Governance": {
    "SecurityLevel": "High",
    "DangerousFunctionPatterns": [
      "^delete($|_)",
      "^remove($|_)",
      "^drop($|_)",
      "^truncate($|_)",
      "^wipe($|_)",
      "^destroy($|_)"
    ]
  },
  "Postgres": {
    "ConnectionString": "Data Source=autoagentes.db"
  },
  "AzureMonitor": {
    "ConnectionString": "InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://westeurope-0.in.applicationinsights.azure.com/"
  },
  "Auth": {
    "Mode": "ApiKey",
    "ApiKeys": [ "dev-key-1" ]
  },
  "RateLimiting": {
    "PermitPerMinute": 120,
    "Burst": 40
  },
  "Budgets": {
    "DefaultToolBudget": 10,
    "DefaultTokenBudget": 50000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
